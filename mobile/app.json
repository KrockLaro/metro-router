{
  "expo": {
    "name": "Маршрутизатор",
    "slug": "metro-router",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1A73E8"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.krocklaro.metrorouter"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1A73E8"
      },
      "package": "com.krocklaro.metrorouter"
    },
      "web": {
      "favicon": "./assets/icon.png"
    }
  }
}